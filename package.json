{
  "name": "dca-helper",
  "version": "1.0.55",
  "description": "Private local portfolio tracker for Interactive Brokers.",
  "main": "electron/main.cjs",
  "scripts": {
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "verify:electron-native": "electron scripts/verify-electron-native.cjs",
    "pretest": "npm run rebuild:node",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "vitest run",
    "posttest": "npm run rebuild:electron",
    "postinstall": "npm run rebuild:electron && npm run verify:electron-native",
    "dist": "npm run build && npm run rebuild:electron && npm run verify:electron-native && electron-builder --win nsis --config.electronDist=node_modules/electron/dist"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.dcahelper.app",
    "productName": "DCA Helper",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "artifactName": "DCA-Helper-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lib/dca.js",
      "src/lib/chartData.js",
      "src/lib/chartCycle.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DCA Helper",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  }
}
